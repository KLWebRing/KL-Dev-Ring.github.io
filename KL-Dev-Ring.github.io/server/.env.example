# ── KL DevVerse — Server Environment ─────────────────────────────────
# Copy this file to .env and fill in your values.
# For cloud setup instructions, see docs/SETUP.md

# ═══════════════════════════════════════════════════════════════════════
# Database — Neon PostgreSQL
# ═══════════════════════════════════════════════════════════════════════
# Create a project at https://neon.tech
# Copy the connection string from the Neon dashboard.
#
# DATABASE_URL uses the pooled connection (for runtime queries)
# DIRECT_URL uses the direct connection (for migrations/schema push)
#
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/kl_devverse?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/kl_devverse?sslmode=require"

# ═══════════════════════════════════════════════════════════════════════
# Cache — Upstash Redis
# ═══════════════════════════════════════════════════════════════════════
# Create a database at https://upstash.com
# Copy the Redis URL (TLS enabled).
#
REDIS_URL="rediss://default:xxx@region.upstash.io:6379"

# ═══════════════════════════════════════════════════════════════════════
# Authentication — GitHub OAuth
# ═══════════════════════════════════════════════════════════════════════
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to match GITHUB_CALLBACK_URL below.
#
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/auth/github/callback"

# ═══════════════════════════════════════════════════════════════════════
# JWT Secrets
# ═══════════════════════════════════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_SECRET="change-me-generate-a-real-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-generate-a-real-refresh-secret"

# ═══════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════
PORT=3001
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# ═══════════════════════════════════════════════════════════════════════
# Colyseus Multiplayer
# ═══════════════════════════════════════════════════════════════════════
COLYSEUS_PORT=2567

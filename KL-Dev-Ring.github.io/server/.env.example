// ── KL DevVerse — Server Environment ─────────────────────────────────
// Copy this file to .env and fill in your values.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kl_devverse?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# GitHub OAuth
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3001/auth/github/callback"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"

# Server
PORT=3001
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Colyseus
COLYSEUS_PORT=2567

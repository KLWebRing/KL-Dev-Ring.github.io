// ── KL DevVerse — Database Schema ────────────────────────────────────
// PostgreSQL via Prisma. Cloud-native with Neon PostgreSQL.
// Future phases add models without modifying existing ones.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════════════════════════
// Users & Auth
// ═══════════════════════════════════════════════════════════════════════

model User {
  id          String   @id @default(cuid())
  githubId    Int      @unique
  username    String   @unique
  displayName String
  avatarUrl   String
  profileUrl  String
  email       String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Phase 2 relations
  sessions         Session[]
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendsA         Friendship[]    @relation("FriendA")
  friendsB         Friendship[]    @relation("FriendB")
  messages         Message[]
  presence         Presence?
  settings         UserSettings?
  profile          UserProfile?

  // Phase 3 relations
  studio          BuilderStudio?
  inventory       InventoryItem[]
  wardrobe        WardrobeItem[]
  achievements    Achievement[]
  builderProgress BuilderProgress?

  // Phase 5 relations
  walletTransactions WalletTransaction[]
  purchases          PurchaseHistory[]
  dailyRewards       DailyReward[]

  // Phase 6 relations
  missionProgress    MissionProgress[]
  questProgress      QuestProgress[]
  career             BuilderCareer?
  careerMilestones   CareerMilestone[]
  reputationHistory  ReputationHistory[]
  skillNodes         SkillNode[]
  timelineEntries    TimelineEntry[]
  activityLogs       ActivityLog[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════
// Friends
// ═══════════════════════════════════════════════════════════════════════

model FriendRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  sender     User          @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User          @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════
// Chat
// ═══════════════════════════════════════════════════════════════════════

model Message {
  id        String      @id @default(cuid())
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel   ChatChannel
  targetId  String?
  content   String      @db.VarChar(1000)
  createdAt DateTime    @default(now())

  @@index([channel, createdAt])
  @@index([authorId])
  @@index([targetId, createdAt])
}

enum ChatChannel {
  GLOBAL
  NEARBY
  DISTRICT
  PRIVATE
  SYSTEM
}

// ═══════════════════════════════════════════════════════════════════════
// Presence
// ═══════════════════════════════════════════════════════════════════════

model Presence {
  id       String     @id @default(cuid())
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   UserStatus @default(ONLINE)
  district String?
  posX     Float      @default(0)
  posZ     Float      @default(0)
  activity String?
  lastSeen DateTime   @default(now())
}

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

// ═══════════════════════════════════════════════════════════════════════
// Profile & Settings
// ═══════════════════════════════════════════════════════════════════════

model UserProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagline      String? @db.VarChar(140)
  builderLevel Int     @default(1)
  xp           Int     @default(0)
  // Future: inventoryId, wardrobeId, organizationId
}

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatEnabled      Boolean @default(true)
  friendRequests   Boolean @default(true)
  showOnlineStatus Boolean @default(true)
  // Future: audioVolume, graphicsQuality, keybinds
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 3 — Builder Identity
// ═══════════════════════════════════════════════════════════════════════

// ── Builder Studio ───────────────────────────────────────────────────

model BuilderStudio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("My Studio")
  tier        Int      @default(1)   // 1=Garage, 2=Workspace, 3=Professional, 4=Innovation Lab, 5=Startup Office, 6=Campus
  theme       String   @default("default")
  floorMat    String   @default("wood")
  wallColor   String   @default("#2a2a3a")
  lightPreset String   @default("warm")
  isPublic    Boolean  @default(true)
  plotX       Float    @default(0)
  plotZ       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  furniture   StudioFurniture[]
  decorations StudioDecoration[]
  visitors    StudioVisit[]
  projectWall ProjectDisplay[]
}

model StudioFurniture {
  id       String        @id @default(cuid())
  studioId String
  studio   BuilderStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  itemId   String
  slotId   String
  posX     Float         @default(0)
  posZ     Float         @default(0)
  rotation Float         @default(0)
  variant  String        @default("default")

  @@index([studioId])
}

model StudioDecoration {
  id       String        @id @default(cuid())
  studioId String
  studio   BuilderStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  itemId   String
  wallId   String
  posX     Float         @default(0)
  posY     Float         @default(0)
  rotation Float         @default(0)

  @@index([studioId])
}

// ── Inventory ────────────────────────────────────────────────────────

model InventoryItem {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId  String
  category   ItemCategory
  quantity   Int          @default(1)
  acquiredAt DateTime     @default(now())
  source     String       @default("starter")

  @@unique([userId, catalogId])
  @@index([userId, category])
}

enum ItemCategory {
  FURNITURE
  COSMETIC
  DECORATION
  SPECIAL
  COLLECTIBLE
}

// ── Wardrobe ─────────────────────────────────────────────────────────

model WardrobeItem {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId  String
  slot       WardrobeSlot
  equipped   Boolean      @default(false)
  acquiredAt DateTime     @default(now())

  @@unique([userId, catalogId])
  @@index([userId, slot])
}

enum WardrobeSlot {
  HAIR
  FACE
  SHIRT
  JACKET
  PANTS
  SHOES
  BACKPACK
  ACCESSORY
}

// ── Builder Progress ─────────────────────────────────────────────────

model BuilderProgress {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  builderPoints       Int      @default(0)
  level               Int      @default(1)
  totalXp             Int      @default(0)
  pointsFromGithub    Int      @default(0)
  pointsFromSocial    Int      @default(0)
  pointsFromExploring Int      @default(0)
  pointsFromBuilding  Int      @default(0)

  // Phase 5 — Wallet Currencies
  builderCash         Int      @default(100)   // Starting bonus
  reputation          Int      @default(0)
  innovationScore     Int      @default(0)
  seasonTokens        Int      @default(0)
  studioValue         Int      @default(0)
  leaderboardRating   Int      @default(1000)  // ELO-style
  prestigeLevel       Int      @default(0)
  dailyLoginStreak    Int      @default(0)
  lastLoginDate       DateTime?

  // Phase 6 — Career & Skills
  careerTitle         String   @default("Newcomer")
  builderRank         Int      @default(1)
  skillPoints         Int      @default(0)
}

// ── Achievements ─────────────────────────────────────────────────────

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achieveId  String
  unlockedAt DateTime @default(now())
  progress   Int      @default(100)

  @@unique([userId, achieveId])
  @@index([userId])
}

// ── Studio Visits ────────────────────────────────────────────────────

model StudioVisit {
  id        String        @id @default(cuid())
  studioId  String
  studio    BuilderStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  visitorId String
  visitedAt DateTime      @default(now())

  @@index([studioId, visitedAt])
  @@index([visitorId])
}

// ── Project Display ──────────────────────────────────────────────────

model ProjectDisplay {
  id          String  @id @default(cuid())
  studioId    String
  studio      BuilderStudio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  repoUrl     String
  repoName    String
  description String  @default("")
  slotIndex   Int
  pinned      Boolean @default(false)

  @@unique([studioId, slotIndex])
  @@index([studioId])
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 5 — Builder Economy
// ═══════════════════════════════════════════════════════════════════════

// ── Wallet Transactions (Audit Log) ──────────────────────────────────

model WalletTransaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  currency      CurrencyType
  amount        Int
  source        String          // e.g. "daily_reward", "purchase", "github_commit"
  description   String          @default("")
  balanceBefore Int
  balanceAfter  Int
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, currency])
}

enum TransactionType {
  EARN
  SPEND
  BONUS
  REFUND
}

enum CurrencyType {
  BUILDER_CASH
  XP
  REPUTATION
  INNOVATION
  SEASON_TOKEN
}

// ── Marketplace Items ────────────────────────────────────────────────

model MarketplaceItem {
  id           String       @id @default(cuid())
  catalogId    String       @unique   // references client catalog
  name         String
  description  String       @default("")
  category     ItemCategory
  rarity       ItemRarity   @default(COMMON)
  price        Int
  currency     CurrencyType @default(BUILDER_CASH)
  isLimited    Boolean      @default(false)
  limitedUntil DateTime?
  stock        Int?         // null = unlimited
  tags         String[]     @default([])
  featured     Boolean      @default(false)
  requiredTier Int          @default(1)   // minimum studio tier
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  purchases    PurchaseHistory[]

  @@index([category])
  @@index([rarity])
  @@index([featured])
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  FOUNDER
  SEASONAL
  DEVELOPER_EXCLUSIVE
}

// ── Purchase History ─────────────────────────────────────────────────

model PurchaseHistory {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceItemId String
  marketplaceItem   MarketplaceItem @relation(fields: [marketplaceItemId], references: [id])
  price             Int
  currency          CurrencyType
  purchasedAt       DateTime        @default(now())

  @@index([userId, purchasedAt])
  @@index([marketplaceItemId])
}

// ── Daily Rewards ────────────────────────────────────────────────────

model DailyReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       Int      // streak day (1, 2, 3, ...7, then repeats)
  reward    String   // JSON: { currency, amount } or { catalogId }
  claimedAt DateTime @default(now())

  @@index([userId, claimedAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Phase 6 — Developer Life Engine
// ═══════════════════════════════════════════════════════════════════════

// ── Missions ─────────────────────────────────────────────────────────

model Mission {
  id           String          @id @default(cuid())
  missionId    String          @unique     // catalog reference
  category     MissionCategory
  name         String
  description  String          @default("")
  requirements String          @default("[]")  // JSON array of conditions
  rewards      String          @default("[]")  // JSON array of rewards
  xpReward     Int             @default(0)
  cashReward   Int             @default(0)
  repReward    Int             @default(0)
  maxProgress  Int             @default(1)
  isActive     Boolean         @default(true)
  isRepeatable Boolean         @default(false)
  minLevel     Int             @default(1)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime        @default(now())

  progress     MissionProgress[]

  @@index([category, isActive])
  @@index([isActive])
}

enum MissionCategory {
  DAILY
  WEEKLY
  MONTHLY
  SEASONAL
  COMMUNITY
  HACKATHON
  EXPLORATION
  LEARNING
  PROJECT
  OPEN_SOURCE
}

model MissionProgress {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  state       MissionState @default(AVAILABLE)
  progress    Int          @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  rewardedAt  DateTime?

  @@unique([userId, missionId])
  @@index([userId, state])
}

enum MissionState {
  LOCKED
  AVAILABLE
  ACTIVE
  COMPLETED
  EXPIRED
  REWARDED
}

// ── Quests ───────────────────────────────────────────────────────────

model Quest {
  id           String     @id @default(cuid())
  questId      String     @unique    // catalog reference
  type         QuestType
  name         String
  description  String     @default("")
  targetAction String     // e.g. "github_commit", "studio_visit"
  targetCount  Int        @default(1)
  xpReward     Int        @default(0)
  cashReward   Int        @default(0)
  repReward    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  progress     QuestProgress[]

  @@index([type, isActive])
}

enum QuestType {
  DAILY
  WEEKLY
}

model QuestProgress {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId      String
  quest        Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  currentCount Int       @default(0)
  completed    Boolean   @default(false)
  claimed      Boolean   @default(false)
  expiresAt    DateTime
  claimedAt    DateTime?

  @@unique([userId, questId, expiresAt])
  @@index([userId, completed])
}

// ── Builder Career ───────────────────────────────────────────────────

model BuilderCareer {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rankName               String   @default("Beginner")
  totalMissionsCompleted Int      @default(0)
  totalQuestsCompleted   Int      @default(0)
  totalProjectsShipped   Int      @default(0)
  joinedAt               DateTime @default(now())
  lastMilestoneAt        DateTime?
}

model CareerMilestone {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  name        String
  description String   @default("")
  achievedAt  DateTime @default(now())

  @@unique([userId, milestoneId])
  @@index([userId, achievedAt])
}

// ── Reputation History ───────────────────────────────────────────────

model ReputationHistory {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      ReputationSource
  description String           @default("")
  givenBy     String?          // nullable userId for peer-given rep
  createdAt   DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([source])
}

enum ReputationSource {
  HELPING
  COMMUNITY
  PROJECT
  MENTORING
  EVENT
  REVIEW
  MISSION
  SYSTEM
}

// ── Skill Tree ───────────────────────────────────────────────────────

model SkillNode {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String      // e.g. "ai_novice", "fullstack_expert"
  branch      SkillBranch
  level       Int         @default(1)   // 1-5 within branch
  xpInvested  Int         @default(0)
  unlockedAt  DateTime    @default(now())

  @@unique([userId, skillId])
  @@index([userId, branch])
}

enum SkillBranch {
  AI
  ML
  FULLSTACK
  CLOUD
  CYBERSECURITY
  GAMEDEV
  ROBOTICS
  OPENSOURCE
  UIUX
  DATASCIENCE
}

// ── Timeline ─────────────────────────────────────────────────────────

model TimelineEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryType   TimelineType
  title       String
  description String       @default("")
  metadata    String       @default("{}")  // JSON
  isPublic    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, isPublic])
}

enum TimelineType {
  JOINED
  STUDIO_CREATED
  PROJECT_PUBLISHED
  HACKATHON_WON
  LEVEL_UP
  STUDIO_UPGRADE
  FEATURED
  MISSION_COMPLETED
  CAREER_MILESTONE
  ACHIEVEMENT_UNLOCKED
  SKILL_UNLOCKED
  RANK_UP
}

// ── Leaderboard Snapshots ────────────────────────────────────────────

model LeaderboardSnapshot {
  id           String          @id @default(cuid())
  board        LeaderboardType
  userId       String
  username     String
  avatarUrl    String          @default("")
  score        Int
  rank         Int
  snapshotDate DateTime        @default(now())

  @@unique([board, userId, snapshotDate])
  @@index([board, rank])
  @@index([board, snapshotDate])
}

enum LeaderboardType {
  LEVEL
  INNOVATION
  REPUTATION
  STUDIO_VALUE
  COMMUNITY
  COLLEGE
  ORGANIZATION
  DISTRICT
  SEASON
}

// ── Activity Log ─────────────────────────────────────────────────────

model ActivityLog {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ActionType
  metadata  String     @default("{}")  // JSON
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

enum ActionType {
  SESSION_START
  SESSION_END
  EXPLORE
  STUDIO_VISIT
  PROJECT_VIEW
  PROJECT_SHARE
  FURNITURE_PLACE
  EVENT_JOIN
  MISSION_COMPLETE
  QUEST_COMPLETE
  MARKETPLACE_PURCHASE
  SKILL_INVEST
}

// ── Game Events (Foundation) ─────────────────────────────────────────

model GameEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  name        String
  description String   @default("")
  type        String   // "seasonal", "hackathon", "community"
  isActive    Boolean  @default(false)
  startsAt    DateTime
  endsAt      DateTime
  rewards     String   @default("[]") // JSON
  metadata    String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  @@index([isActive, startsAt])
}

{
  "name": "kl-dev-ring",
  "version": "0.2.0",
  "private": true,
  "description": "Kerala's open-source developer metaverse.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:app": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "node scripts/build.js",
    "build:app": "vite build",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run validate && npm test && npm run build",
    "snapshot": "node scripts/snapshot.js",
    "server:install": "cd server && npm install",
    "server:migrate": "cd server && npx prisma migrate dev",
    "server:studio": "cd server && npx prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "colyseus.js": "^0.16.22",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "zustand": "^5.0.14"
  }
}
